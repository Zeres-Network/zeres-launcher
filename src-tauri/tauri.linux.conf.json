{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["rpm", "deb", "appimage"],
    "category": "Game",
    "shortDescription": "Launcher de Zeres Network",
    "icon": ["icons/icon.png"],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libsoup3"]
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}

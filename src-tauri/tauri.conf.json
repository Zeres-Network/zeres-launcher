{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeres Launcher",
  "version": "0.1.2",
  "identifier": "fun.zeres.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zeres Launcher",
        "width": 1000,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RDI0MUU0NDExNjExOTgKUldTWUVSWkI1RUhTS2QzWDFHVVptTlMvbjhWaVFzakJlb2F0QlBYdWVMa2p1YnlNdjVSMU1vL2kK",
      "endpoints": [
        "https://github.com/Zeres-Network/zeres-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}